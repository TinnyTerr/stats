{
  "port": 3000,
  "host": "127.0.0.1",
  "pollIntervalMs": 5000,
  "retentionHours": 24,
  "dbPath": "./stats.db",
  "token": null,

  "servers": [
    {
      "id": "laptop",
      "name": "This laptop",
      "driver": "local",
      "tags": ["local"],
      "notes": "The hub itself — collected in-process, no agent needed."
    },
    {
      "id": "web-1",
      "name": "Web 1",
      "driver": "agent",
      "url": "http://10.0.0.5:9101",
      "token": "env:WEB1_TOKEN",
      "tags": ["prod", "docker"],
      "notes": "nginx + compose stack"
    },
    {
      "id": "db-1",
      "name": "Database",
      "driver": "agent",
      "url": "http://10.0.0.6:9101",
      "token": "env:DB1_TOKEN",
      "tags": ["prod", "postgres"]
    }
  ]
}
