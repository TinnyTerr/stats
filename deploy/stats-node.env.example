# Copy to /etc/stats/node.env (chmod 600, owned by root).
# `install.sh --node --hub <url> --token <token>` writes this file for you.

# Where the hub is. Accepts host, host:port, http(s):// or ws(s)://.
STATS_HUB=ws://hub.lan:3000

# Must match the hub's nodeToken (or this node's own token in its `nodes` entry).
# Generate one on the hub with:  openssl rand -hex 32
STATS_NODE_TOKEN=replace-me

# Optional: override the node's identity. The id defaults to /etc/machine-id
# and the name to the hostname. Changing the id makes the hub treat this as a
# new machine, so set it once and leave it alone.
#STATS_NODE_ID=web-1
#STATS_NODE_NAME=Web 1
#STATS_TAGS=prod,docker

# Optional: how often to send telemetry, in ms. The hub can ask for slower.
#STATS_INTERVAL=3000

# Optional: refuse the two non-read-only capabilities. 0 disables.
#STATS_TERMINAL=0
#STATS_CONTROL=0

# Optional: let the hub ask this node to replace its own binary. Off by
# default. The node still resolves and verifies the release itself — the hub
# can only ask, never say where from. `stats update` on the host works
# regardless of this setting.
#
# The shipped unit runs as User=stats with ProtectSystem=full, so the node
# cannot write /usr/local/bin/stats and this will fail with a permission error
# until you add a drop-in with ReadWritePaths=/usr/local/bin and chown the
# binary. See "Updating" in the README before you do.
#STATS_ALLOW_REMOTE_UPDATE=1

# Optional: projects file or directory (colon-separated).
# Defaults to /etc/stats/projects.json then /etc/stats/projects.d/.
#STATS_PROJECTS=/etc/stats/projects.json:/srv/app/stats-projects.json

# Optional: extra directories readable through the kind=file log source.
#STATS_LOG_DIRS=/var/log:/srv/myapp/logs

# Optional: non-standard docker socket (e.g. rootless docker).
#DOCKER_SOCKET=/run/user/1000/docker.sock

# Optional: watch a Proxmox host this node is NOT running on. On the hypervisor
# itself the module uses pvesh, which is already authenticated, and needs none
# of this. Create the token with:
#   pveum user token add stats@pve dashboard --privsep 0
#   pveum acl modify / --tokens 'stats@pve!dashboard' --roles PVEAuditor
# (add PVEVMAdmin instead if you want start/stop from the dashboard)
#PROXMOX_URL=https://pve.lan:8006
#PROXMOX_TOKEN=stats@pve!dashboard=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PVE ships a self-signed certificate; set this to accept it.
#PROXMOX_INSECURE=1
