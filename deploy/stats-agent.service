# Install on each server:
#   sudo cp deploy/stats-agent.service /etc/systemd/system/
#   sudo systemctl edit stats-agent    # set STATS_AGENT_TOKEN
#   sudo systemctl enable --now stats-agent
#
# The agent is read-only: it exposes metrics and log tails, and offers no way
# to start, stop or exec anything.

[Unit]
Description=stats agent (read-only host metrics)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/stats
ExecStart=/usr/local/bin/bun index.ts agent --port 9101 --host 0.0.0.0
Restart=on-failure
RestartSec=5

# Required for the token; put it in a root-only file rather than inline here.
EnvironmentFile=/etc/stats-agent.env

# Needs the docker socket group to read container state. Drop this line, and the
# docker collector simply reports unavailable while everything else keeps working.
SupplementaryGroups=docker

# Read-only workload, so lock it down.
DynamicUser=no
User=stats
Group=stats
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
