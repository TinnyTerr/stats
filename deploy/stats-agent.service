# Manual install of the agent. `install.sh --agent` writes an equivalent unit
# for you — keep the two in step if you change one.
#
#   sudo cp deploy/stats-agent.service /etc/systemd/system/
#   sudo install -d /etc/stats
#   sudo install -m 600 deploy/stats-agent.env.example /etc/stats/agent.env
#   sudo systemctl enable --now stats-agent
#
# Assumes the compiled binary at /usr/local/bin/stats. To run from source
# instead, use: ExecStart=/usr/local/bin/bun /opt/stats/index.ts agent --port 9101
#
# The agent is read-only: it exposes metrics and log tails, and offers no way
# to start, stop or exec anything.

[Unit]
Description=stats agent (read-only host metrics)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/stats agent --port 9101 --host 0.0.0.0
Restart=on-failure
RestartSec=5

# Required for the token; put it in a root-only file rather than inline here.
EnvironmentFile=/etc/stats/agent.env

User=stats
Group=stats

# docker: container state. systemd-journal: the kind=journal log source. Drop
# either line and that collector reports unavailable while the rest keeps working.
SupplementaryGroups=docker systemd-journal

# Read-only workload, so lock it down.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
